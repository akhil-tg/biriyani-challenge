# Biriyani Challenge — Environment Configuration
# Copy this file to .env or configure in your deployment platform.
# On Cloudflare Workers, set these as worker secrets:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_KEY

# Supabase configuration
# The system uses Supabase Auth + normalized PostgreSQL tables (coordinators, items, orders).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
