# Biriyani Challenge — Environment Configuration
# Copy this file to .env or configure in your deployment platform (e.g. Cloudflare / Railway / Render / Docker)

# Server port (default: 3000 for Node, 7860 for Docker)
PORT=3000

# Supabase configuration (optional)
# When set, the system uses Supabase Auth + normalized PostgreSQL tables (coordinators, items, orders).
# If omitted, server.js falls back to local data/db.json storage with 4-digit PIN authentication.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key

