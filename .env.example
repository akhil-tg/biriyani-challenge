# Biriyani Challenge — Environment Configuration
# On Cloudflare Workers, set these as worker secrets:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_KEY
#   npx wrangler secret put AUTH_SECRET

# Supabase configuration (data access via PostgREST)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# AUTH_SECRET: random long secret used to sign login session tokens.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate-a-random-64-char-hex-string
